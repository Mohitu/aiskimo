{
  // Typechecks the emulator suite, which the build config deliberately excludes.
  // Without this the tests would be checked by nothing until they were run.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/**/*.ts",
    "../src/domain/**/*.ts",
    "../src/services/**/*.ts",
    "../src/platform/**/*.ts",
    "../src/data/mock/**/*.ts"
  ],
  "exclude": ["lib"]
}
