{
  "name": "aiskimo-functions",
  "version": "1.0.0",
  "private": true,
  "description": "The agent API, served. Wraps the same gateway the app uses — no rules live here.",
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "npm run build && firebase deploy --only functions",
    "seed": "tsx src/seed.ts",
    "test:emulator": "firebase emulators:exec --only firestore --project aiskimo-emulator-test \"vitest run\"",
    "emulators": "firebase emulators:start --only functions,firestore --project aiskimo-emulator-test"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
