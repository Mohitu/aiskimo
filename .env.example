# Firebase — optional.
#
# Leave these unset and Aiskimo runs on the in-memory mock adapter: the full UI
# works, including self-registration and claiming. Fill them in (copy this file
# to .env.local) and the app switches to Firebase Auth + Firestore with no code
# changes.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
